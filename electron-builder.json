{
  "appId": "com.kira.ai.os",
  "productName": "KIRA AI Operating System",
  "copyright": "Copyright © 2026 KIRA AI Team",
  "directories": {
    "output": "dist_electron"
  },
  "files": [
    "dist/**/*",
    "electron/**/*"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "public/icon.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "KIRA AI Operating System"
  },
  "publish": {
    "provider": "github",
    "owner": "kira-ai",
    "repo": "kira-os"
  }
}
