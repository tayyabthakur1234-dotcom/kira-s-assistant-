# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# KIRA AI Desktop Control Engine Settings
KIRA_HOST="0.0.0.0"
KIRA_PORT="8000"
KIRA_DEBUG="true"
KIRA_REQUIRE_CONFIRMATION="true"
KIRA_HUMAN_MOUSE_SPEED="0.3"
KIRA_LOG_LEVEL="INFO"

# KIRA AI Phase 2 Vision & Screen Intelligence Settings
KIRA_VISION_LOCAL_ONLY="false"
KIRA_OCR_ENGINE="auto"
TESSERACT_CMD="C:\Program Files\Tesseract-OCR\tesseract.exe"
KIRA_VISION_CONFIDENCE_THRESHOLD="0.6"

# KIRA AI Phase 3 Browser Intelligence Settings
KIRA_BROWSER_TYPE="chromium"
KIRA_BROWSER_HEADLESS="true"
KIRA_BROWSER_DOWNLOADS_DIR="downloads"

# KIRA AI Phase 4 Voice Intelligence Settings
KIRA_WAKE_WORD="Hey Kira"
KIRA_WAKE_SENSITIVITY="0.5"
KIRA_VOICE_ENGINE="kokoro"
KIRA_VOICE_PROFILE="female_1"
KIRA_STT_MODEL="base"
KIRA_AUDIO_SAMPLE_RATE="16000"

# KIRA AI Phase 5 Memory & Planner Settings
KIRA_DB_PATH="kira_memory.db"
KIRA_VECTOR_DB_DIR="kira_vector_db"
KIRA_MEMORY_DECAY_DAYS="30"
KIRA_AUTO_EXTRACT_MEMORY="true"
KIRA_MAX_PLANNER_RETRIES="3"

# KIRA AI Phase 6 Plugin Platform & MCP Settings
KIRA_PLUGINS_DIR="plugins"
KIRA_PLUGIN_SANDBOX="true"
KIRA_PLUGIN_AUTO_RELOAD="true"
KIRA_MCP_CONFIG_PATH="mcp_config.json"

# KIRA AI Phase 12 - AI Model Router & Multi-Agent Intelligence Settings
GROK_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
DEEPSEEK_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"
KIRA_AUTO_FAILOVER="true"
KIRA_SELF_VERIFICATION="true"

